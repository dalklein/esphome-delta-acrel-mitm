# Copy to secrets.yaml (gitignored) and fill in.
wifi_ssid: "your-ssid"
wifi_ssid_g: "your-ssid-2.4G"       # a second network; both are tried
wifi_password: "your-wifi-password"
ap_password: "fallback-ap-password"
ota_key_delta_acrel_mitm: "base64-32-byte-key"   # OTA encryption key: openssl rand -base64 32
mqtt_broker_ip: "192.168.1.10"
mqtt_username: "mqtt-user"
mqtt_password: "mqtt-password"
